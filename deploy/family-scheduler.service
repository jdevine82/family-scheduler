[Unit]
Description=Devine Family Planner
After=network.target

[Service]
Type=simple
# Update these paths/user to match your install:
User=family-scheduler
WorkingDirectory=/opt/family-scheduler
ExecStart=/opt/family-scheduler/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8420

Restart=on-failure
RestartSec=5

# Logs go to the systemd journal: journalctl -u family-scheduler -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
